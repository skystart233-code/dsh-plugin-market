{
  "name": "@local/dsh-plugin-market",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH plugin market in the sidebar: browse the goodcase.ai snapshot and install or uninstall plugins in one click.",
  "license": "MIT",
  "author": "TKK (https://github.com/skystart233-code)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skystart233-code/dsh-plugin-market.git"
  },
  "homepage": "https://github.com/skystart233-code/dsh-plugin-market#readme",
  "bugs": {
    "url": "https://github.com/skystart233-code/dsh-plugin-market/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "plugin-market",
    "marketplace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
